# Where the Ghostless API runs. Read on the server only, never sent to browsers.
GHOSTLESS_API_URL=http://127.0.0.1:8000

# Public URL of this site: canonical links, social previews, and the Google and
# GitHub sign-in callback. Must match the API's GHOSTLESS_SITE_URL exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The same secret as the API's GHOSTLESS_INTERNAL_KEY. Lets the API see each
# visitor's real IP address for rate limits and visitor counts.
GHOSTLESS_INTERNAL_KEY=
