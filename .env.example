# Copy to .env and fill in. `ghostless` loads .env automatically.

# PostgreSQL connection string. The default matches `docker compose up -d db`.
DATABASE_URL=postgresql://tracker:tracker@localhost:5432/tracker

# Used by the database integration tests (can be the same database).
TEST_DATABASE_URL=postgresql://tracker:tracker@localhost:5432/tracker

# A URL or email that site owners can use to reach you. It is sent in the
# User-Agent header of every request. If you run this tracker yourself,
# please set it to your own repository or email.
GHOSTLESS_CONTACT=

# Optional: path to a different companies file.
# GHOSTLESS_COMPANIES=companies.yaml

# ---------------------------------------------------------------------------
# Web API (`ghostless serve`). Only needed where the API runs.
# ---------------------------------------------------------------------------

# The website's public URL: used in email links (confirm address, reset password).
GHOSTLESS_SITE_URL=http://localhost:3000

# Browsers allowed to call the API directly (comma separated). The website
# calls it from its server, so this only matters for the future browser extension.
# GHOSTLESS_CORS_ORIGINS=https://ghostless.example

# A long random secret shared with the website (set the same value there).
# It lets the website pass on each visitor's IP address for rate limits and
# visitor counts. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GHOSTLESS_INTERNAL_KEY=

# A long random secret for counting unique visitors without storing IP
# addresses. Set it in production so counts survive restarts.
GHOSTLESS_ANALYTICS_SALT=

# Email for account confirmation and password resets, through Resend
# (free tier: 3,000 emails a month). Without these, emails are printed in the
# API's log instead, which is fine for local development.
# RESEND_API_KEY=
# GHOSTLESS_EMAIL_FROM=Ghostless <hello@your-domain.com>

# Optional "Continue with Google" and "Continue with GitHub" buttons. Each
# appears on the site once both its values are set. README.md explains how
# to create them (both are free). GHOSTLESS_SITE_URL above must be the
# site's exact address, because the sign-in callback is built from it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional AI resume review (Claude). Everything else works without it.
# ANTHROPIC_API_KEY=
# GHOSTLESS_AI_MODEL=claude-haiku-5-5
# GHOSTLESS_AI_DAILY_PER_USER=5
# GHOSTLESS_AI_DAILY_TOTAL=200
