# Copy to .env and fill in. `ghostless` loads .env automatically.

# PostgreSQL connection string. The default matches `docker compose up -d db`.
DATABASE_URL=postgresql://tracker:tracker@localhost:5432/tracker

# Used by the database integration tests (can be the same database).
TEST_DATABASE_URL=postgresql://tracker:tracker@localhost:5432/tracker

# A URL or email that site owners can use to reach you. It is sent in the
# User-Agent header of every request. If you run Ghostless yourself,
# please set it to your own repository or email.
GHOSTLESS_CONTACT=

# Optional: path to a different companies file.
# GHOSTLESS_COMPANIES=companies.yaml
